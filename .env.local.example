# ParaguAI website env vars
# Public (NEXT_PUBLIC_*) — safe to commit, sent to browser bundle
NEXT_PUBLIC_WHATSAPP=595981324569
NEXT_PUBLIC_SITE_URL=https://paragu-ai.com
# Google Analytics (optional — get ID from analytics.google.com)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Supabase (server-only — DO NOT add NEXT_PUBLIC_ prefix)
# Server-side admin API routes use supabaseAdmin (lib/supabase-admin.ts)
SUPABASE_URL=https://abcdefghijk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin auth (HMAC secret for session cookies)
# Generate: openssl rand -hex 32
ADMIN_AUTH_SECRET=replace_with_64_char_hex_string

# --- Supabase 2026 secret proxy (optional, defensive) ---
# If the app ever needs browser-side Supabase, point NEXT_PUBLIC_SUPABASE_URL
# at the Edge Function proxy instead of the project root. See
# docs/supabase-proxy-deploy.md for the deploy steps.
#
# CURRENT: app uses SUPABASE_URL directly (server-only). NEXT_PUBLIC_SUPABASE_URL
# is the same URL exposed to the browser bundle for completeness.
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijk.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijk.supabase.co/functions/v1/paragu-proxy/  # with proxy

# Optional: explicit publishable key for browser-side use (currently unused)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx